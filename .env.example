# Copy to .env and fill in.
# Tiger Cloud (TimescaleDB) service URL, as shown in the Tiger Cloud console.
TIMESCALE_DB_URL=postgres://tsdbadmin@your-service.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
# Password for the URL above (read natively by libpq/psycopg, no URL-encoding needed).
PGPASSWORD=
# Optional host port for the API (default 8000).
FASTAPI_PORT=8000
