{
  "uid": "room-sentinel",
  "title": "Room Sentinel",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT device_id FROM readings WHERE time > now() - interval '7 days' GROUP BY device_id ORDER BY max(time) DESC",
        "definition": "SELECT device_id FROM readings WHERE time > now() - interval '7 days' GROUP BY device_id ORDER BY max(time) DESC",
        "refresh": 2,
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperatures by sensor",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time_bucket(make_interval(secs => $__interval_ms / 1000.0), time) AS time, sensor, avg(temp_c) AS temp_c\nFROM readings\nWHERE $__timeFilter(time) AND device_id = '$device' AND temp_c IS NOT NULL\nGROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Room temperature and cooling rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time_bucket(make_interval(secs => $__interval_ms / 1000.0), time) AS time, name, avg(value) AS value\nFROM metrics\nWHERE $__timeFilter(time) AND device_id = '$device' AND name IN ('room_c', 'rate_c_per_min', 'expected_rate_c_per_min')\nGROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Forecast (minutes)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time, value AS \"forecast\" FROM metrics\nWHERE device_id = '$device' AND name = 'forecast_minutes' AND $__timeFilter(time)\nORDER BY time DESC LIMIT 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Healthy sensors",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time_bucket(make_interval(secs => $__interval_ms / 1000.0), time) AS time, avg(value) AS sensors_ok\nFROM metrics\nWHERE $__timeFilter(time) AND device_id = '$device' AND name = 'sensors_ok'\nGROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Issue events",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time, severity, event, kind, sensor, message\nFROM issue_events\nWHERE $__timeFilter(time) AND device_id = '$device'\nORDER BY time DESC LIMIT 200"
        }
      ]
    }
  ]
}
